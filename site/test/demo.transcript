# pool.toml: the pool agents would join; no agent has
name = "gpu"
class = "gpu-host"
max_machines = 1

[shape]
cpu_millis = 64000
memory_bytes = 549755813888
gpus = 8
gpu_class = "nvidia-a100"
$ printf 'a-local-token-of-at-least-32-bytes\n' > client-token && chmod 600 client-token
$ js-lease-server --state-file state --boot initialise --token-file client-token --agent-pool-config pool.toml --job-listen 127.0.0.1:7301 &
$ js --server http://127.0.0.1:7301 --token-file client-token job submit --id demo-1 --spec.image registry.example/train@sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 --spec.needs.gpus 1 --spec.needs.gpu-class nvidia-a100 --spec.wall-limit-seconds 1h
