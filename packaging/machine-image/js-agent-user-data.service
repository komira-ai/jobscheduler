# The user-data reader of a jobscheduler machine image (docs/runbooks/machine-images.md). The
# provider's user data is a cloud-config whose `write_files` puts this host's configuration at
# fixed paths; cloud-init writes them in `cloud-init.service`, before this unit runs. The unit
# checks that the two required files are there and reloads systemd, so the agent's unit starts
# with the drop-in the user data wrote (systemd read its units before the drop-in existed).
#
#   /etc/systemd/system/js-agent-crun.service.d/50-user-data.conf   required: the agent's
#       command line, `ExecStart=` cleared and set again with this host's --server and --pool
#   /etc/js-agent/token                                              required, mode 0600: the
#       join token
#   /etc/hostkeeper/hostkeeper.toml                                  optional, mode 0600:
#       hostkeeper's config (it holds no secret); without it hostkeeper does not start
#
# js-agent-crun.service requires this unit (its drop-in 10-image.conf), so a machine booted with
# no user data, or with user data that lacks a required file, does not start the agent:
# `systemctl status js-agent-user-data` names the missing path. Installed by the image build as
# /etc/systemd/system/js-agent-user-data.service and enabled.
[Unit]
Description=jobscheduler agent: the configuration the provider's user data placed
Documentation=https://github.com/komira-ai/jobscheduler/blob/main/docs/runbooks/machine-images.md
After=cloud-init.service
Before=js-agent-crun.service hostkeeper.service
AssertPathExists=/etc/systemd/system/js-agent-crun.service.d/50-user-data.conf
AssertPathExists=/etc/js-agent/token

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemctl daemon-reload

[Install]
WantedBy=multi-user.target
