# js-agent on a Linux farm node that runs jobs with crun, as the unit of the js-agent .deb
# (packaging/js-agent/deb). It is the unit of packaging/js-agent/js-agent-crun.service, which the
# held host setup script installs, with the differences listed below. The package installs it as
#   /usr/lib/systemd/system/js-agent-crun.service
#   /usr/lib/tmpfiles.d/js-agent-crun.conf        (the package's tmpfiles.conf)
# and the agent as /usr/bin/js-agent. hostkeeper installs the package (apt) at its `activate`
# step, before `cutover` restarts the unit, so one install replaces the program the next start
# runs. crates/xtask/tests/js_agent_deb_units.rs pins the settings described here. The package is
# public and the same on every host, so what is a host's own is not in it: the join token
# (/etc/js-agent/token, root's, mode 0600) and the flags file (/etc/js-agent/flags: --server, --pool,
# --instance-file and the rest, one per line) are placed by the operator, and `--flags-file` reads
# the second at start. The package enables nothing: hostkeeper starts, stops and enables the unit.
#
# crun is the runtime of the agent's Linux build, so the unit names no runtime: the crun flags
# below are the ones it takes. The packaged Docker unit and the elastic boot payload name
# `--allow-container-engine --container-bin`, the opt-in to the engine fallback.
#
# The agent stays root and runs every `crun` as the job user (`--job-user`), a system account
# that the package's postinst makes from its sysusers file (/usr/lib/sysusers.d/js-agent.conf),
# with a subuid and subgid range of 65536 ids or more that the postinst gives it where the host
# has none (see packaging/js-agent/deb/README.md). At start the
# agent checks the host (crun and its version, newuidmap and newgidmap, the job user's ranges,
# the roots' modes, the cgroup controllers, the AppArmor profile for /usr/bin/crun) and exits 2
# naming each piece that is missing; `journalctl -u js-agent-crun` shows the list. The program
# must be the distribution's /usr/bin/crun: its AppArmor profile, which lets it make a user
# namespace where kernel.apparmor_restrict_unprivileged_userns is 1, attaches to that path.
#
# Settings that differ from js-agent.service, and why:
#   Delegate=yes          the agent makes a cgroup per run below its own and gives it to the job
#                         user, which needs the cpu, memory and pids controllers delegated
#   DelegateSubgroup=supervisor
#                         systemd starts the agent in the leaf <unit>/supervisor, so the unit's own
#                         cgroup holds no process (cgroup v2's no-internal-process rule) and can
#                         enable cpu, memory and pids in its subtree_control for the sibling
#                         <unit>/actions that holds every lease cgroup. Needs systemd 254 or newer
#                         (Ubuntu 24.04 ships 255); the setup script refuses an older one. The name
#                         is the one js-contain's delegate step already treats as the agent's leaf,
#                         so it derives the unit cgroup, and <unit>/actions below it, from it
#   Slice=                the node's job load is one slice, which an operator can cap
#   StateDirectory=       with StateDirectoryMode=0711 makes /var/lib/js-agent searchable by
#                         others: the job's ids walk down through it to the scratch root
#                         (0711, see the tmpfiles file); the state root below stays 0700
#   --scratch-root       the runs directory inside the scratch mount, so the image store, which
#                         the agent places beside the scratch root (<scratch>/oci), is on the
#                         same disk as the leases; the mount itself is what the unit waits for
#   KillMode=process      systemd signals the agent's main process alone, on a stop and
#                         after a crash, and never kills the rest of the unit: each crun
#                         container runs under a supervisor process of its own (in the
#                         agent's leaf) and in a lease cgroup under <unit>/actions, and both
#                         outlive the agent. The next agent the unit starts (Restart=always)
#                         adopts every container its ledger records and lists the jobs again,
#                         so a crash does not cost a running job. A container's wall limit
#                         is enforced only while an agent runs: the time it ran with no agent
#                         counts, and one whose limit passed meanwhile is stopped at the
#                         first step after the adoption. An agent with an --egress ceiling
#                         leaves each run's network wiring as it is when it ends, and the next
#                         one adopts it from the run's record in the egress store (the directory
#                         egress of the state root, written when the run was wired): a container
#                         whose record is missing or differs is removed and its job lost; a
#                         container that ended meanwhile is adopted and its result reported
#   --drain-wait 3600 --stop-grace 120   a plain stop (systemctl stop) drains: the agent lets
#                         the running jobs finish for up to an hour (the most --drain-wait
#                         allows) and then stops them within 120 s before it exits. An update
#                         hands the runs over in place and does not stop the unit: its cutover
#                         writes the file handover in the state root and sends the agent SIGHUP
#                         (systemctl kill --kill-whom=main); the agent takes no new job, waits
#                         until no start, stop or post-job check is under way (seconds;
#                         --drain-wait at most), and runs its program again in the same process,
#                         which adopts every run, as after a crash. The unit is not stopped and
#                         systemd starts nothing, so it places no process in the unit's cgroup
#                         while the leases hold their controllers. The update hook does this
#                         only when the running and the staged agent both list `in-place` on the
#                         `stops:` line of `js-agent --version` (and `handover`, and
#                         `egress-handover` if the flags file has an --egress). An update whose
#                         agents cannot stops and starts the unit on systemd 257 or older, with
#                         the handover file written before the stop, and drains on 258 or newer
#                         (ExecStopPost= below says why); see docs/runbooks/crun-host-setup.md
#   TimeoutStopSec=3900   the longest drain (3600 + 120 s) plus the 30 s the server gets to
#                         acknowledge the results and a margin; finite, so a hung agent is
#                         killed (its main process alone, as above: what it still ran is
#                         adopted) and Restart=always brings it back. Raise it with either flag.
#   ExecStart=/usr/bin/js-agent
#                         the program the package installs. The server and the pool come from
#                         --flags-file, not from this file: the unit is the same on every host
#   --health-listen 127.0.0.1:7311
#                         the route hostkeeper probes as the package's healthUrl
#                         (http://127.0.0.1:7311/healthz, in the release manifest): 200 while the
#                         agent is admitted and neither it nor the lease server holds a taint on
#                         the host, 503 and the reason otherwise, so a tainted host is reported
#                         unhealthy. Loopback only; the farm unit has no such route
#   (no ExecStartPre=)    the agent makes its state root (mode 0700) and its scratch root (mode
#                         0711) itself at start when they are missing, the leaf only; the
#                         tmpfiles file is applied at boot and by the setup script
#   ExecStopPost=/usr/bin/js-agent crun-start-refused --result ${SERVICE_RESULT}
#                         systemd 258 or newer clones the first process of a start into the
#                         unit's own cgroup and moves it to <unit>/supervisor only after, and the
#                         kernel refuses a process in a cgroup that has controllers enabled for its
#                         children, which the leases under <unit>/actions keep. So a start with
#                         runs left (after a crash, since Restart=always starts the unit again
#                         with them) is refused, result `resources`, until they end. This step
#                         runs after every stop, in <unit>/.control, which the kernel accepts, and
#                         does nothing unless the result is `resources`; then, on systemd 258 or
#                         newer, it ends the runs left (the supervisors first, then the lease
#                         cgroups) so that the next start, Restart=always, places the agent. Those
#                         runs are lost: no agent could report them while the unit could not start
#   Wants=/After=js-agent-crun-gpu.service
#                         a oneshot that writes, before each start, the drop-in with the --gpu-*
#                         flags for the host's NVIDIA nodes, and reloads systemd (see that unit).
#                         On a host without a GPU node it writes none; when it fails the agent
#                         starts without GPUs. Flags listed here by hand take its place
# No container engine is in After= and none is pulled in.
#
# Like js-agent.service, the unit runs as root with no sandboxing (the agent reads /proc/1/ns and
# owns the state and scratch roots); add none of the Protect*, Private*, Restrict* or
# Capability* settings. Put host-specific flags in /etc/js-agent/flags, not in a drop-in.
[Unit]
Description=jobscheduler agent (crun runtime)
Documentation=https://github.com/komira-ai/jobscheduler
After=network-online.target js-agent-crun-gpu.service
Wants=network-online.target js-agent-crun-gpu.service
Conflicts=js-agent.service
RequiresMountsFor=/var/lib/js-agent/scratch
ConditionPathIsMountPoint=/var/lib/js-agent/scratch

[Service]
Type=simple
Slice=jobscheduler.slice
Delegate=yes
DelegateSubgroup=supervisor
StateDirectory=js-agent
StateDirectoryMode=0711
ExecStart=/usr/bin/js-agent --flags-file /etc/js-agent/flags --health-listen 127.0.0.1:7311 --token-file /etc/js-agent/token --drain-wait 3600 --stop-grace 120 --crun-bin /usr/bin/crun --job-user jsjob --state-root /var/lib/js-agent/state --scratch-root /var/lib/js-agent/scratch/runs
ExecStopPost=/usr/bin/js-agent crun-start-refused --result ${SERVICE_RESULT}
KillMode=process
TimeoutStopSec=3900
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
