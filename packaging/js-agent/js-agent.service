# js-agent on a Linux host, installed by the js-agent deb (packaging/js-agent).
#
# js-agent is configured by flags only (it reads no environment variable and no config
# file), so the host's values are the flags of ExecStart below. Edit the server and the pool
# to the host's with `systemctl edit js-agent` (a drop-in that first clears ExecStart=
# and then sets the whole line again), then `systemctl enable --now js-agent`.
#
# Files the agent uses, all owned by root and closed to group and others:
#   /etc/js-agent/token             the pool's join token (mode 0600), made by the operator;
#                                   the agent refuses a token file that is not a regular
#                                   file of its own user with mode 0600 or 0400
#   /var/lib/js-agent/state         the state root (mode 0700): the taint marker and, once the
#                                   server has admitted the host, `host-credential` (mode
#                                   0600, written by the agent); it replaces the token
#   /var/lib/js-agent/scratch       the scratch root (mode 0700): a private directory per run
# The directories are made by systemd-tmpfiles (tmpfiles.d/js-agent.conf). The agent refuses a
# state root on the same disk as the scratch root, so mount a disk of its own at the scratch
# root; RequiresMountsFor keeps the agent from starting before that mount is there.
#
# Restart=always, and not on-failure, and no RestartPreventExitStatus=2: the agent exits 0
# after SIGTERM or SIGINT (it announced `draining`), 1 when its signal handlers or job worker
# fail, and 2 for a wrong flag or file, a job engine it cannot use, or a server that refuses
# the host for good. After any exit it may leave containers of its jobs behind, and only the
# next process adopts them (or stops them), so the supervisor must start the agent after every
# exit, 0 and 2 included. A refusal restarts every RestartSec seconds and is read from the
# journal; the restart does not hide it.
[Unit]
Description=jobscheduler agent
Documentation=https://github.com/komira-ai/jobscheduler
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/js-agent/scratch

[Service]
Type=simple
ExecStart=/usr/bin/js-agent --server https://js.example.com --token-file /etc/js-agent/token --pool default --container-bin /usr/bin/docker --state-root /var/lib/js-agent/state --scratch-root /var/lib/js-agent/scratch
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
