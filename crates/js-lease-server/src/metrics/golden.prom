js_submit_phase_seconds_bucket{phase="validation",le="0.25"} 1
js_submit_phase_seconds_bucket{phase="validation",le="1"} 1
js_submit_phase_seconds_bucket{phase="validation",le="+Inf"} 1
js_submit_phase_seconds_sum{phase="validation"} 0.00005
js_submit_phase_seconds_count{phase="validation"} 1
js_submit_phase_seconds_bucket{phase="get",le="0.0001"} 0
