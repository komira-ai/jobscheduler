# HELP js_jobs Jobs in the job tables, by state.
# TYPE js_jobs gauge
js_jobs{state="queued"} 2
js_jobs{state="placed"} 2
js_jobs{state="starting"} 1
js_jobs{state="running"} 1
js_jobs{state="succeeded"} 1
js_jobs{state="failed"} 1
js_jobs{state="cancelled"} 1
js_jobs{state="lost"} 1
js_jobs{state="failed-to-start"} 1
# HELP js_queue_oldest_age_seconds How long the oldest queued job has waited since its submit; 0 with none queued.
# TYPE js_queue_oldest_age_seconds gauge
js_queue_oldest_age_seconds 90.064
# HELP js_job_placements_total Queued jobs placed on a host.
# TYPE js_job_placements_total counter
js_job_placements_total 2
# HELP js_queue_wait_seconds How long each placed job waited in the queue, from its submit to its placement.
# TYPE js_queue_wait_seconds histogram
js_queue_wait_seconds_bucket{le="1"} 1
js_queue_wait_seconds_bucket{le="5"} 1
js_queue_wait_seconds_bucket{le="30"} 1
js_queue_wait_seconds_bucket{le="60"} 2
js_queue_wait_seconds_bucket{le="300"} 2
js_queue_wait_seconds_bucket{le="900"} 2
js_queue_wait_seconds_bucket{le="3600"} 2
js_queue_wait_seconds_bucket{le="14400"} 2
js_queue_wait_seconds_bucket{le="86400"} 2
js_queue_wait_seconds_bucket{le="+Inf"} 2
js_queue_wait_seconds_sum 46
js_queue_wait_seconds_count 2
# HELP js_job_start_failures_total Jobs that failed to start, by failure code.
# TYPE js_job_start_failures_total counter
js_job_start_failures_total{code="no-capacity"} 1
js_job_start_failures_total{code="start-timeout"} 1
js_job_start_failures_total{code="exclusive-not-ready"} 1
js_job_start_failures_total{code="agent-refused"} 1
# HELP js_jobs_lost_total Jobs lost with their host or container.
# TYPE js_jobs_lost_total counter
js_jobs_lost_total 2
# HELP js_store_write_failures_total Passes over the job tables the server makes itself (the job pass, a placement, a heartbeat's job listing) that failed, so their write did not commit.
# TYPE js_store_write_failures_total counter
js_store_write_failures_total 1
# HELP js_job_pass_duration_seconds How long each job pass of the tick took.
