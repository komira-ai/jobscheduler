js_job_pass_duration_seconds_bucket{le="+Inf"} 2
js_job_pass_duration_seconds_sum 0.033
js_job_pass_duration_seconds_count 2
# HELP js_acquires_total Launches the scaler ran, by pool, whatever their answer.
# TYPE js_acquires_total counter
js_acquires_total{pool="gpu"} 3
# HELP js_acquire_failovers_total Launches refused for capacity or quota, after which the scaler tries another offer, by pool.
# TYPE js_acquire_failovers_total counter
js_acquire_failovers_total{pool="gpu"} 1
