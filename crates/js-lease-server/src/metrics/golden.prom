# HELP js_jobs Jobs in the job tables, by state.
# TYPE js_jobs gauge
js_jobs{state="queued"} 2
js_jobs{state="placed"} 2
js_jobs{state="starting"} 1
js_jobs{state="running"} 1
js_jobs{state="succeeded"} 1
js_jobs{state="failed"} 1
js_jobs{state="cancelled"} 1
js_jobs{state="lost"} 1
js_jobs{state="failed-to-start"} 1
# HELP js_queue_oldest_age_seconds How long the oldest queued job has waited since its submit; 0 with none queued.
# TYPE js_queue_oldest_age_seconds gauge
js_queue_oldest_age_seconds 90.064
# HELP js_callback_pending Completion callbacks of ended jobs not yet delivered, abandoned or expired; one past its deadline counts until a try finds it expired.
# TYPE js_callback_pending gauge
js_callback_pending 0
# HELP js_job_placements_total Queued jobs placed on a host.
# TYPE js_job_placements_total counter
js_job_placements_total 2
# HELP js_queue_wait_seconds How long each placed job waited in the queue, from its submit to its placement.
# TYPE js_queue_wait_seconds histogram
js_queue_wait_seconds_bucket{le="1"} 1
js_queue_wait_seconds_bucket{le="5"} 1
js_queue_wait_seconds_bucket{le="30"} 1
js_queue_wait_seconds_bucket{le="60"} 2
js_queue_wait_seconds_bucket{le="300"} 2
js_queue_wait_seconds_bucket{le="900"} 2
js_queue_wait_seconds_bucket{le="3600"} 2
js_queue_wait_seconds_bucket{le="14400"} 2
js_queue_wait_seconds_bucket{le="86400"} 2
js_queue_wait_seconds_bucket{le="+Inf"} 2
js_queue_wait_seconds_sum 46
js_queue_wait_seconds_count 2
# HELP js_job_start_failures_total Jobs that failed to start, by failure code.
# TYPE js_job_start_failures_total counter
js_job_start_failures_total{code="no-capacity"} 1
js_job_start_failures_total{code="start-timeout"} 1
js_job_start_failures_total{code="exclusive-not-ready"} 1
js_job_start_failures_total{code="agent-refused"} 1
js_job_start_failures_total{code="input-unavailable"} 1
# HELP js_jobs_lost_total Jobs lost with their host or container.
# TYPE js_jobs_lost_total counter
js_jobs_lost_total 2
# HELP js_job_retries_total Attempts of jobs that ended in a way that retries and were followed by another, by how they ended: start-failed (a start failure of the host's) or host-lost.
# TYPE js_job_retries_total counter
js_job_retries_total{outcome="start-failed"} 3
js_job_retries_total{outcome="host-lost"} 1
# HELP js_job_attempts_exhausted_total Jobs that ended in a way that retries with no attempt left under their retry policy.
# TYPE js_job_attempts_exhausted_total counter
js_job_attempts_exhausted_total 2
# HELP js_store_write_failures_total Passes over the job tables the server makes itself (the job pass, a placement, a heartbeat's job listing) that failed, so their write did not commit.
# TYPE js_store_write_failures_total counter
js_store_write_failures_total 1
# HELP js_job_pass_duration_seconds How long each job pass of the tick took.
# TYPE js_job_pass_duration_seconds histogram
js_job_pass_duration_seconds_bucket{le="0.001"} 0
js_job_pass_duration_seconds_bucket{le="0.005"} 1
js_job_pass_duration_seconds_bucket{le="0.01"} 1
js_job_pass_duration_seconds_bucket{le="0.05"} 2
js_job_pass_duration_seconds_bucket{le="0.1"} 2
js_job_pass_duration_seconds_bucket{le="0.5"} 2
js_job_pass_duration_seconds_bucket{le="1"} 2
js_job_pass_duration_seconds_bucket{le="5"} 2
js_job_pass_duration_seconds_bucket{le="+Inf"} 2
js_job_pass_duration_seconds_sum 0.033
js_job_pass_duration_seconds_count 2
# HELP js_job_tables_total Passes over the queued jobs, by where each took the job tables from: read from the store, kept from the last read with no write since, kept with the jobs this server's submits recorded since added to them, or brought up to date from the store's feed with the rows that changed since the last read.
# TYPE js_job_tables_total counter
js_job_tables_total{from="store"} 1
js_job_tables_total{from="kept"} 2
js_job_tables_total{from="submitted"} 3
js_job_tables_total{from="changed"} 4
# HELP js_submit_phase_seconds How long each phase of each SubmitJob call took, by phase: validation (the checks of the job), get (the read of its id, for a job with one), admission (for a job not yet held), insert-checkout (of the insert, getting connections of the store's pool), insert-transaction (the rest of the insert) or note-inserted (the placer told of the job, never waiting for a pass). A call is timed in each phase it reaches, whatever the answer.
# TYPE js_submit_phase_seconds histogram
js_submit_phase_seconds_bucket{phase="validation",le="0.0001"} 1
js_submit_phase_seconds_bucket{phase="validation",le="0.00025"} 1
js_submit_phase_seconds_bucket{phase="validation",le="0.0005"} 1
