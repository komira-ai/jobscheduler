(version 1)
(allow default)
(deny file-write*)
(deny job-creation)
(deny lsopen)
(deny user-preference-write)
(allow file-write* (subpath (param "RUN")) (literal "/dev/null") (subpath "/dev/fd"))
(deny file-read* (subpath (param "HM_0")))
(deny file-read* (subpath (param "HM_1")))
(deny file-read* (subpath (param "HM_2")))
(deny file-read* (subpath (param "HM_3")))
(allow file-read* (subpath (param "OWN")))
(allow file-read-metadata (path-ancestors (param "OWN")))
(deny process-exec* (subpath (param "MOUNT")))
(deny file-map-executable (subpath (param "MOUNT")))
(deny file-read* (subpath (param "MOUNT")))
(allow file-read* (subpath (param "MT_0")))
(allow file-read-metadata (path-ancestors (param "MT_0")))
(deny file-link file-clone (subpath (param "HM_0")))
(deny file-link file-clone (subpath (param "HM_1")))
(deny file-link file-clone (subpath (param "HM_2")))
(deny file-link file-clone (subpath (param "HM_3")))
(allow file-link file-clone (subpath (param "OWN")))
(deny file-read* (subpath (param "RD_0")))
(deny file-write* (subpath (param "RD_0")))
(deny file-link file-clone (subpath (param "RD_0")))
(allow file-read* (subpath (param "GR_0")))
(allow file-read-metadata (path-ancestors (param "GR_0")))
(allow file-link file-clone (subpath (param "GR_0")))
(deny process-exec* (subpath (param "GR_0")))
(deny file-map-executable (subpath (param "GR_0")))
(deny network*)
(allow network-outbound (literal "/private/var/run/syslog"))
(deny network-outbound (remote unix-socket (subpath (param "RD_0"))))
(deny network-bind (local unix-socket (subpath (param "RD_0"))))
(deny process-info* (target others))
(allow process-info* (target self) (target same-sandbox))
(deny mach-register)
(deny file-mount)
(deny ipc-posix-shm-write-create)
(deny job-creation)
(deny lsopen)
(deny file-read* file-write* (subpath "/private/var/protected/sfanalytics") (subpath "/private/var/protected/trustd/private"))
(deny mach-lookup (global-name-prefix "com.apple.CoreDevice."))
(deny mach-lookup (global-name-prefix "com.apple.remoted"))
(deny network-outbound (literal "/private/var/run/usbmuxd"))
