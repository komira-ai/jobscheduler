(version 1)
(allow default)
(deny file-write*)
(deny job-creation)
(deny lsopen)
(deny user-preference-write)
(allow file-write* (subpath (param "RUN")) (literal "/dev/null") (subpath "/dev/fd"))
(deny file-read*)
(allow file-read-metadata (path-ancestors (param "RUN")))
(allow file-read-metadata (literal "/usr") (literal "/var"))
(allow file-read* (literal "/") (subpath "/System/Library") (subpath "/System/Volumes/Preboot/Cryptexes") (subpath "/usr/lib") (subpath "/usr/bin") (subpath "/usr/share") (subpath "/bin") (subpath "/private/var/db/timezone") (literal "/dev/null") (literal "/dev/tty"))
(allow file-read* (subpath (param "RUN")))
(deny file-read* (literal "/System/Library/CoreServices/RemoteManagement/ARDAgent.app/Contents/MacOS/ARDAgent") (literal "/bin/ps") (literal "/usr/bin/at") (literal "/usr/bin/atq") (literal "/usr/bin/atrm") (literal "/usr/bin/batch") (literal "/usr/bin/crontab") (literal "/usr/bin/login") (literal "/usr/bin/newgrp") (literal "/usr/bin/quota") (literal "/usr/bin/su") (literal "/usr/bin/sudo") (literal "/usr/bin/top") (literal "/usr/bin/write"))
(deny network*)
(allow network-outbound (literal "/private/var/run/syslog"))
(allow network-inbound (local ip "localhost:*"))
(allow network* (remote ip "localhost:*"))
(deny process-info* (target others))
(allow process-info* (target self) (target same-sandbox))
(deny mach-register)
(deny file-mount)
(deny job-creation)
(deny lsopen)
(deny file-read* file-write* (subpath "/private/var/protected/sfanalytics") (subpath "/private/var/protected/trustd/private"))
(deny mach-lookup (global-name-prefix "com.apple.CoreDevice."))
(deny mach-lookup (global-name-prefix "com.apple.remoted"))
(deny network-outbound (literal "/private/var/run/usbmuxd"))
