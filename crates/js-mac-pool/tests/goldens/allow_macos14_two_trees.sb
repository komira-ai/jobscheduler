(version 1)
(allow default)
(deny file-write*)
(deny job-creation)
(deny lsopen)
(deny user-preference-write)
(allow file-write* (subpath (param "RUN")) (subpath (param "UENTRY")) (literal "/dev/null") (subpath "/dev/fd"))
(deny file-read*)
(allow file-read-metadata (path-ancestors (param "RUN")) (path-ancestors (param "UENTRY")) (path-ancestors (param "TREE_0")) (path-ancestors (param "TREE_1")) (path-ancestors (param "XCODE_APP")))
(allow file-read* (literal "/") (subpath "/System/Library") (subpath "/System/Cryptexes") (subpath "/System/Volumes/Preboot/Cryptexes") (subpath "/usr/lib") (subpath "/usr/bin") (subpath "/usr/sbin") (subpath "/usr/libexec") (subpath "/usr/share") (subpath "/bin") (subpath "/sbin") (subpath "/private/var/db/dyld") (subpath "/private/var/db/timezone") (literal "/private/var/select/sh") (literal "/dev/null") (literal "/dev/zero") (literal "/dev/random") (literal "/dev/urandom") (literal "/dev/tty"))
(allow file-read* (subpath (param "RUN")) (subpath (param "UENTRY")))
(allow file-read* (subpath (param "TREE_0")) (subpath (param "TREE_1")))
(allow file-read* (subpath (param "XCODE_APP")) (literal "/Library/Preferences/com.apple.dt.Xcode.plist"))
(allow file-read* (subpath "/private/etc/ssl") (subpath "/System/Library/Security"))
(allow file-read* (literal "/private/etc/localtime") (subpath "/usr/share/zoneinfo"))
(deny file-read* (literal "/System/Library/CoreServices/RemoteManagement/ARDAgent.app/Contents/MacOS/ARDAgent") (literal "/bin/ps") (literal "/sbin/ping") (literal "/usr/bin/at") (literal "/usr/bin/atq") (literal "/usr/bin/atrm") (literal "/usr/bin/batch") (literal "/usr/bin/crontab") (literal "/usr/bin/login") (literal "/usr/bin/newgrp") (literal "/usr/bin/quota") (literal "/usr/bin/su") (literal "/usr/bin/sudo") (literal "/usr/bin/top") (literal "/usr/libexec/authopen") (literal "/usr/libexec/security_authtrampoline") (literal "/usr/sbin/traceroute") (literal "/usr/sbin/traceroute6"))
(deny file-read* (subpath (param "RD_0")))
(deny file-write* (subpath (param "RD_0")))
(deny file-read* (subpath (param "RD_1")))
(deny file-write* (subpath (param "RD_1")))
(deny file-write* (subpath (param "IN_0")))
(deny network*)
(allow network-outbound (literal "/private/var/run/syslog"))
(deny network-outbound (remote unix-socket (subpath (param "RD_0"))))
(deny network-bind (local unix-socket (subpath (param "RD_0"))))
(deny network-outbound (remote unix-socket (subpath (param "RD_1"))))
(deny network-bind (local unix-socket (subpath (param "RD_1"))))
(deny process-info* (target others))
(allow process-info* (target self) (target same-sandbox))
(deny mach-register)
(deny file-mount)
(deny job-creation)
(deny lsopen)
(deny file-read* file-write* (subpath "/private/var/protected/sfanalytics") (subpath "/private/var/protected/trustd/private"))
(deny mach-lookup (global-name-prefix "com.apple.CoreDevice."))
(deny mach-lookup (global-name-prefix "com.apple.remoted"))
(deny network-outbound (literal "/private/var/run/usbmuxd"))
