load("//:buildrules.bzl", "cargo_package")

# What this package reads beyond what buildrules gives each of its units (a library src/ and
# build.rs, a test target tests/), which a Buck2 action sees only when declared:
# tests/build_script.rs includes build.rs.
cargo_package(
    path = ".",
    extra_srcs = [
        "build.rs",
    ],
)

# Read by other members (their extra_srcs); exported by reference, so each stays at its path.
export_file(
    name = "proto",
    src = "proto",
    mode = "reference",
    visibility = ["PUBLIC"],
)
