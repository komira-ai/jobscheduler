load("//:buildrules.bzl", "cargo_package")

# What this package reads beyond what buildrules gives each of its units (a library src/ and
# build.rs, a test target tests/), which a Buck2 action sees only when declared: src/lib.rs
# includes the farm's shapes, farm/.
cargo_package(
    path = ".",
    extra_srcs = [
        "farm",
    ],
)
