load("//:buildrules.bzl", "cargo_package")

# What this package reads beyond what buildrules gives each of its units (a library src/ and
# build.rs, a test target tests/), which a Buck2 action sees only when declared: the library
# includes a pfctl golden of tests/golden.
cargo_package(
    path = ".",
    extra_srcs = [
        "tests/golden",
    ],
)
