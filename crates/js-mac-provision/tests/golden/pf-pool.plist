<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>js-agent.pf-pool</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Application Support/js-agent/bin/js-mac-provision</string>
		<string>install</string>
		<string>--flags-file</string>
		<string>/etc/js-agent/flags</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>30</integer>
	<key>StandardErrorPath</key>
	<string>/var/log/js-mac-provision.log</string>
</dict>
</plist>
