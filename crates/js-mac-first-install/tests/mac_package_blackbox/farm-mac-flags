# The js-agent flags of a Mac of the build farm, in shape: the flags the farm's Mac host group
# commits in its config package (/etc/js-agent/flags), the same flags with the same kinds of
# value, in the same order. What names the farm is replaced: the lease server's address is the
# test's own server (the placeholder of the --server line), and nothing here names a host, an
# address or a key of the farm.
# When the farm's file gains, drops or changes the kind of a flag, this copy changes with it.
#
# The host's identity: hostkeeper's facts and host certificate, and the lease server's CA.
--server={server}
--pool=mac-build
--host-id-from-facts=/var/lib/hostkeeper/facts.json
--ca-cert=/etc/js-agent/ca.pem
--host-cert=/var/lib/hostkeeper/identity/host.crt
--host-key=/var/lib/hostkeeper/identity/host.key
# The native runtime: each job a slot account of the agent's pool.
--native-accounts=/var/db/js-agent/accounts
--native-account-range=700-799
--native-account-ready=1
--native-network=loopback
--native-tool-root=/usr/bin
--native-tool-root=/bin
--native-tool-root=/usr/sbin
--native-tool-root=/sbin
--native-tool-root=/Library/Developer/CommandLineTools/usr/bin
# Bundles, from the public registry the release publishes to, by the digests of bundle-allow.
--bundle-store=/var/db/js-agent/scratch/bundles
--bundle-budget-gib=50
--bundle-pull=missing
--bundle-trust=list
--bundle-allow-file=/etc/js-agent/bundle-allow
--image-allow=ghcr.io/komira-ai/js/smoke
--image-allow=ghcr.io/komira-ai/kbf-task
# Input trees: tierstore's mount provider, its account, and its one mount of the node, which is
# a read-only mount root and the native runtime's trees root.
--mount-provider=tierstore=/usr/local/tierstore/run/provider.sock
--mount-provider-user=tierstore=_tierstore
--mount-root-ro=trees=/private/var/tierstore/fs
--native-trees-root=/private/var/tierstore/fs
# Outputs by put: tierstore's put directory and the account its ingest runs as.
--native-put-root=/usr/local/tierstore/put
--native-put-user=_tierstore
# The per-second recorders.
--cpu-series
--host-second-samples
--memory-series
