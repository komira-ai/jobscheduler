load("//:buildrules.bzl", "cargo_package")

# What this package reads beyond what buildrules gives each of its units (a library src/ and
# build.rs, a test target tests/), which a Buck2 action sees only when declared: examples/sim_x2.rs
# takes its engine from tests/sim_x_replay (`#[path]`).
cargo_package(
    path = ".",
    extra_srcs = [
        "tests/fixtures/sim_x_trace.bin",
        "tests/sim_x_replay/engine",
    ],
)
